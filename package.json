{
  "name": "@konomanoasa/tree-sitter-json",
  "version": "0.3.0",
  "description": "Tree-sitter grammar for JSON.",
  "license": "MIT",
  "repository": "git+https://github.com/konomanoasa/tree-sitter-json.git",
  "type": "module",
  "files": [
    "Cargo.toml",
    "bindings/python/*.c",
    "bindings/python/*.py",
    "bindings/python/*.pyi",
    "bindings/python/py.typed",
    "bindings/rust/*.rs",
    "grammar.js",
    "pyproject.toml",
    "queries/*.scm",
    "setup.py",
    "src/*.c",
    "src/*.json",
    "src/tree_sitter/*.h",
    "test/bindings.test.rs",
    "tree-sitter.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run tree-sitter -- build",
    "check": "biome check . && tsc",
    "check:queries": "npm run tree-sitter -- check-queries",
    "format": "biome format --write .",
    "generate": "npm run tree-sitter -- generate",
    "test": "npm run tree-sitter -- test-corpus --rebuild && node --test --test-concurrency=1 test/build.test.js test/cst.test.js test/highlight.test.js test/incremental.test.js test/parser.test.js",
    "test:fuzz": "npm run tree-sitter -- fuzz --iterations 100 --edits 5",
    "tree-sitter": "node scripts/tree-sitter.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "26.6.5",
    "tree-sitter-cli": "0.27.1",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "tree-sitter-cli": true
  }
}
