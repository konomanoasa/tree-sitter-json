{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "json",
      "title": "JSON",
      "scope": "source.json",
      "path": ".",
      "file-types": [
        "json"
      ],
      "injection-regex": "^json$",
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.4.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for JSON.",
    "links": {
      "repository": "https://github.com/konomanoasa/tree-sitter-json"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": true,
    "rust": true,
    "swift": false
  }
}
